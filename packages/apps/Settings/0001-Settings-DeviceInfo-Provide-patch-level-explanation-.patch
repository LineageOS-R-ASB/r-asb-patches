From 4273afc890019f26e51ba76e26ff0f5750a351ea Mon Sep 17 00:00:00 2001
From: MSe <mse1969@posteo.de>
Date: Mon, 24 Sep 2018 21:09:57 +0200
Subject: [PATCH 1/3] Settings/DeviceInfo - Provide "patch level" explanation
 and disclaimer

Make it clear to the user, that this is an outdated, no longer
supported Android version. And that we have only backported stuff
from newer Android versions in the monthly Android security bulletins.

[ A2L5E0X1: adapt for LOS 18.1 ]

Change-Id: I6d706dcb598dd836c6a6f0b499782be9bd59b4dc
---
 res/values/cm_strings.xml                     |  4 ++++
 res/xml/firmware_version.xml                  |  2 +-
 ...ecurityPatchLevelPreferenceController.java | 19 ++++++++-----------
 3 files changed, 13 insertions(+), 12 deletions(-)

diff --git a/res/values/cm_strings.xml b/res/values/cm_strings.xml
index d13d4d4fe8..5e6a1832c7 100644
--- a/res/values/cm_strings.xml
+++ b/res/values/cm_strings.xml
@@ -178,4 +178,8 @@
 
     <!-- Warning message for the sd card setup -->
     <string name="storage_warning_internal">Warning: This option may not work properly or lead to data loss and is therefore not recommended!</string>
+
+    <!-- "Legacy" Security Patch label -->
+    <string name="security_patch_legacy">Unofficial security backport</string>
+    <string name="security_patch_legacy_info">There are no official security patches for this Android version anymore. \nAll patches contained in this build are backports from newer versions.</string>
 </resources>
diff --git a/res/xml/firmware_version.xml b/res/xml/firmware_version.xml
index 2669fb7341..9a3e1e1a97 100644
--- a/res/xml/firmware_version.xml
+++ b/res/xml/firmware_version.xml
@@ -50,7 +50,7 @@
     <!-- Security patch -->
     <Preference
         android:key="security_key"
-        android:title="@string/security_patch"
+        android:title="@string/security_patch_legacy"
         settings:enableCopying="true"
         settings:controller="com.android.settings.deviceinfo.firmwareversion.SecurityPatchLevelPreferenceController"/>
 
diff --git a/src/com/android/settings/deviceinfo/firmwareversion/SecurityPatchLevelPreferenceController.java b/src/com/android/settings/deviceinfo/firmwareversion/SecurityPatchLevelPreferenceController.java
index 1df78a8081..14cfc65193 100644
