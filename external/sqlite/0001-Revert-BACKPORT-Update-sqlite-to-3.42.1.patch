-
-/*
-** Open an kvvfs file handle.
-*/
-static int kvvfsOpen(
-  sqlite3_vfs *pProtoVfs,
-  const char *zName,
-  sqlite3_file *pProtoFile,
-  int flags,
-  int *pOutFlags
-){
-  KVVfsFile *pFile = (KVVfsFile*)pProtoFile;
-  if( zName==0 ) zName = "";
-  SQLITE_KV_LOG(("xOpen(\"%s\")\n", zName));
-  if( strcmp(zName, "local")==0
-   || strcmp(zName, "session")==0
